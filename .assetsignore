# Files in the repository that must NOT be served as public static assets.
# Uses .gitignore syntax. The worker script and anything it imports are still
# bundled as code — excluding them here only stops them being fetchable URLs.

worker.js
wrangler.toml
.assetsignore
.gitignore
.dev.vars.example

# Server-side code
functions/

# Internal build documentation and tooling
docs/
.claude/
CLAUDE.md
AGENTS.md
PLACEHOLDER-CONTENT.md
README.md

# Source material for the recorded service-card clips, not part of the site
mocks/

# Remotion project used to prototype brand video clips. Superseded by an
# AI-generated clip (assets/video/promo-bg.mp4) — kept locally only, now
# excluded from git entirely via .gitignore, so this line is belt-and-braces
# in case it's ever restored.
video-studio/

# Client-supplied reference recordings, if they are ever un-ignored in git
examples/

# Node
node_modules/
package.json
package-lock.json

# Version control internals — never serve these
.git/

# Wrangler's own local dev cache/state — watching this causes an infinite
# reload loop in `wrangler dev` (cache write triggers watcher triggers
# reload triggers cache write...)
.wrangler/
