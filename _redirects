# The canonical-host redirect is NOT here. Workers static assets only support
# relative destinations, so an absolute cross-host rule is parsed and skipped
# with a warning. www -> apex is handled at the top of worker.js instead.

# Strip .html extensions
/index.html      /            301
/services.html   /services    301
/work.html       /work        301
/insights.html   /insights    301
/about.html      /about       301
/contact.html    /contact     301

# Legacy or mistyped paths
/portfolio       /work        301
/blog            /insights    301
/contact-us      /contact     301
