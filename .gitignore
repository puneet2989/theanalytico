# Reference material — client-supplied screen recordings of a third-party site.
# 73 MB, not ours to redistribute, and not needed to build or run the site.
examples/

# Remotion authoring project used to prototype the work.html showcase video.
# That direction was superseded by an AI-generated clip (see PLACEHOLDER-
# CONTENT.md); this is a local scratch tool, not part of the shipped site,
# and already excluded from served assets via .assetsignore.
video-studio/

# Secrets. Only the .example template is tracked.
.dev.vars
.env
.env.*

# Cloudflare / Wrangler local state
.wrangler/
.mf/

# Node
node_modules/
npm-debug.log*
# package-lock.json is tracked: Workers Builds should install a pinned
# dependency tree rather than resolving a fresh wrangler on every build.

# Editor and OS noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Windows zone-identifier side files created when copying downloads into WSL
*:Zone.Identifier
*:*.Zone.Identifier
*:PG$Secure
*:Avecto.Zone.Identifier

# Local scratch
*.log
/tmp/
